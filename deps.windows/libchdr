## Build Steps
libchdr_setup() {
  if [ ! -d "libchdr" ]; then
    git clone https://github.com/rtissera/libchdr
  else
    git -C libchdr fetch
  fi
  git -C libchdr reset --hard "$libchdr_hash"
}

