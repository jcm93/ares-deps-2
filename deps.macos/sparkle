## Build Steps
sparkle_setup() {
  curl -L -o ${sparkle_name}-${sparkle_version}.tar.xz ${sparkle_url}
  mkdir ${sparkle_name}-${sparkle_version}
  tar xf ${sparkle_name}-${sparkle_version}.tar.xz -C ${sparkle_name}-${sparkle_version}
}

