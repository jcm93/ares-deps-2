sparkle_install() {
  ditto build_temp/${sparkle_name}-${sparkle_version}/Sparkle.framework ares-deps/lib/Sparkle.framework
  ditto build_temp/${sparkle_name}-${sparkle_version}/Symbols/Sparkle.framework.dSYM ares-deps/lib/Sparkle.framework.dSYM
  ditto build_temp/${sparkle_name}-${sparkle_version}/LICENSE ares-deps/licenses/Sparkle/LICENSE
}



